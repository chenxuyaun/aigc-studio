APP_ENV=development
APP_NAME=AIGC Studio
APP_DEBUG=true
# 生产环境必须换强随机值：openssl rand -hex 32（deploy/scripts/setup_prod.sh 可自动生成）
APP_SECRET_KEY=change-me-to-random-secret
APP_BASE_URL=http://localhost:5000

FRONTEND_PORT=5000
# 避开宿主机 grok2api 的 8000 端口；若服务器 grok2api 用其他端口可改回
API_INTERNAL_PORT=8002

MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=aigc_studio
MYSQL_USER=aigc
MYSQL_PASSWORD=changeme
MYSQL_ROOT_PASSWORD=changeme

# compose 场景：api/worker 容器由 compose.yaml 注入 DATABASE_URL（连 mysql 服务名），无需在此填写。
# systemd/裸机部署如需 MySQL：DATABASE_URL=mysql+aiomysql://aigc:密码@127.0.0.1:3306/aigc_studio
# DATABASE_URL=

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

JWT_SECRET_KEY=change-me-to-random-jwt-secret
JWT_ACCESS_TOKEN_MINUTES=30
JWT_REFRESH_TOKEN_DAYS=14

INITIAL_ADMIN_EMAIL=admin@aigc.local
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=changeme

# local | s3 | r2 | b2 | minio
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./storage
# S3 兼容（R2 示例）：
# STORAGE_PROVIDER=r2
# STORAGE_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
# STORAGE_BUCKET=aigc-studio
# STORAGE_REGION=auto
# STORAGE_PUBLIC_BASE_URL=https://pub-xxxx.r2.dev
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=aigc-studio
STORAGE_REGION=auto
STORAGE_PUBLIC_BASE_URL=
# 用户媒体预签名 TTL（秒）；R2 写流量灰度 0–100（0=全 local）
STORAGE_SIGNED_GET_TTL_SECONDS=300
STORAGE_R2_WRITE_PERCENT=0

DEFAULT_TEXT_PROVIDER=mock
DEFAULT_IMAGE_PROVIDER=mock
DEFAULT_VIDEO_PROVIDER=mock
DEFAULT_SPEECH_PROVIDER=mock

# OpenAI 兼容端点（grok2api / vLLM / Ollama 等均可）
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=
# 同一模型相邻生成的最小间隔（秒），0=不限；防本地 grok2api 被刷
OPENAI_COMPATIBLE_MIN_INTERVAL=0
OPENAI_COMPATIBLE_IMAGE_MODEL=
OPENAI_COMPATIBLE_VIDEO_MODEL=

LITELLM_ENABLED=false
LITELLM_BASE_URL=
LITELLM_API_KEY=

PROMPT_SOURCE_QQSRC_ENABLED=false
PROMPT_SOURCE_QQSRC_MODE=metadata_only
PROMPT_SOURCE_QQSRC_AUTHORIZED_IMPORT=false

CORS_ALLOWED_ORIGINS=http://localhost:5000
LOG_LEVEL=INFO

MOCK_PROVIDER_DELAY_MIN_MS=300
MOCK_PROVIDER_DELAY_MAX_MS=2000
MOCK_PROVIDER_FAILURE_RATE=0

# 0=进程内 asyncio 跑媒体任务；1=投递 Celery（需 worker）
USE_CELERY_WORKER=0
# 简易内存限流（单实例）；0=关闭
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_LOGIN_PER_MINUTE=20

# 可选：本地 SearXNG 聚合搜索（创作接入网络检索；缺省时自动降级 Wikipedia）
# SEARXNG_URL=http://127.0.0.1:8080

# 可选：角色陪伴 MemoryCore 记忆网关（:8420，compose 已含 memory-core 服务）
# TDAI_MEMORY_ENDPOINT=http://memory-core:8420
# TDAI_MEMORY_API_KEY=
# TDAI_LLM_BASE_URL=
# TDAI_LLM_API_KEY=
# TDAI_LLM_MODEL=

# Redis 密码（若 compose.yaml 的 redis 设了密码需同步）
# REDIS_PASSWORD=

# 可选：非开放注册时，演示/内部注册的内部密钥
# REGISTER_INTERNAL_KEY=

# 可选：HuggingFace Token（模型/素材下载）
# HUGGINGFACE_TOKEN=

# 可选：grok2api 管理后台凭据（仅用于 API 调用鉴权，勿公开真实值）
# GROK2API_ADMIN_USERNAME=
# GROK2API_ADMIN_PASSWORD=

# 进阶（默认值即可）：
# DB_ECHO=false
# TRUST_PROXY=0
# USER_STORAGE_QUOTA_BYTES=0

# Figma（可选；仅本机 .env 填写真实 Token，勿提交）
# FIGMA_TOKEN=
# FIGMA_TEAM_ID=
# FIGMA_PROJECT_ID=

# 内置「Hermes（本地 Ollama）」的 base_url 覆盖（默认 host.docker.internal:11434，compose 部署直连宿主机）
# 裸机部署改：OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_BASE_URL=
