# AIGC Studio 云部署环境模板
# 用法：cp .env.cloud.example .env 后逐项填写（值不能含空格）
# 警告：本文件含密钥，禁止提交到 git / 分享

# ── 数据库 ──
MYSQL_DATABASE=aigc_studio
MYSQL_USER=aigc
MYSQL_PASSWORD=<改我>
MYSQL_ROOT_PASSWORD=<改我>

# Redis 密码（必改；api/worker 自动拼接带密码的 URL）
REDIS_PASSWORD=<改我>

# ── 平台 ──
APP_ENV=production
APP_NAME=AIGC Studio
APP_BASE_URL=https://aigc.example.com
APP_SECRET_KEY=<改我：openssl rand -hex 32>
JWT_SECRET_KEY=<改我：openssl rand -hex 32>
JWT_ACCESS_TOKEN_MINUTES=30
JWT_REFRESH_TOKEN_DAYS=14

# 初始管理员（首次启动自动创建）
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=<改我>
INITIAL_ADMIN_EMAIL=admin@example.com

# CORS（浏览器跨域白名单，逗号分隔；通常同源可留空）
CORS_ALLOWED_ORIGINS=https://aigc.example.com

# ── LLM 网关（grok2api 在本编排内，走 host.docker.internal）──
OPENAI_COMPATIBLE_BASE_URL=http://host.docker.internal:8000/v1
OPENAI_COMPATIBLE_API_KEY=<改我：grok2api 客户端 Key>
OPENAI_COMPATIBLE_MODEL=grok-chat-fast
OPENAI_COMPATIBLE_IMAGE_MODEL=grok-imagine-image
DEFAULT_TEXT_PROVIDER=openai_compatible
DEFAULT_IMAGE_PROVIDER=openai_compatible

# 注册机 / cpa 地址（本编排内，保留默认）
# GROK_ADMIN_BASE=http://host.docker.internal:8000
# REGISTER_BASE=http://host.docker.internal:6657
# CPA_BASE=http://host.docker.internal:8317

# ── 角色陪伴记忆（memory-core）──
TDAI_MEMORY_ENDPOINT=http://memory-core:8420
TDAI_MEMORY_API_KEY=<改我：openssl rand -hex 16>

# ── 存储（默认本地卷）──
STORAGE_PROVIDER=local
# STORAGE_PUBLIC_BASE_URL=

# ── 其他（按需）──
USE_CELERY_WORKER=1
LOG_LEVEL=INFO
TZ=Asia/Shanghai
