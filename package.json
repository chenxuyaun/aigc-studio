{
  "name": "aigc-studio",
  "private": true,
  "version": "0.1.0",
  "description": "AIGC Studio - AI 创作中心 (Monorepo)",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @aigc/web dev",
    "build": "pnpm --filter @aigc/web build",
    "preview": "pnpm --filter @aigc/web preview",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test:run",
    "test:e2e": "pnpm --filter @aigc/web test:e2e",
    "format": "prettier --write \"**/*.{ts,tsx,css,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,css,json,md}\""
  },
  "devDependencies": {
    "prettier": "^3.4.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
